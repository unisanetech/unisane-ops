{
  "name": "@unisane/ops-engine",
  "version": "0.1.0",
  "description": "Headless operations planning, safety, state-port, receipt, and drift engine for Unisane",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "import": "./dist/local.js",
      "default": "./dist/local.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js",
      "default": "./dist/lifecycle.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js",
      "default": "./dist/pack.js"
    },
    "./readiness": {
      "types": "./dist/readiness.d.ts",
      "import": "./dist/readiness.js",
      "default": "./dist/readiness.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/lifecycle.ts src/local.ts src/pack.ts src/readiness.ts src/testing.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/lifecycle.ts src/local.ts src/pack.ts src/readiness.ts src/testing.ts --format esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}
