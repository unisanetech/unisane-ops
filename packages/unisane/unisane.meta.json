{
  "schemaVersion": 1,
  "kind": "tooling",
  "id": "unisane",
  "edition": "oss",
  "maturity": "beta",
  "supportedModes": [
    "full-platform",
    "headless"
  ],
  "requiresPackages": [
    "@unisane/cloud",
    "@unisane/framework-ops",
    "@unisane/growth",
    "@unisane/ops-engine",
    "@unisane/ops-mcp",
    "@unisane/provider-aws",
    "@unisane/provider-cloudflare",
    "@unisane/provider-google",
    "@unisane/provider-meta"
  ],
  "requiresTokens": [],
  "runtimeProfiles": [
    "local-minimal",
    "standard-production",
    "distributed-production"
  ],
  "docs": [
    "README.md"
  ],
  "exports": [
    "./config",
    "./core-manifest",
    "./handlers/add",
    "./handlers/check",
    "./handlers/connect",
    "./handlers/disconnect",
    "./handlers/init",
    "./handlers/inspect-packs",
    "./handlers/mcp",
    "./handlers/migrate-growth-config",
    "./handlers/status"
  ]
}
