{
  "name": "@unisane/provider-meta",
  "version": "0.1.0",
  "description": "Meta provider-family connection and control-plane operations for Unisane Ops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisanetech/unisane-ops.git",
    "directory": "packages/provider-meta"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./marketing": {
      "types": "./dist/meta/marketing/index.d.ts",
      "import": "./dist/meta/marketing/index.js",
      "default": "./dist/meta/marketing/index.js"
    },
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/meta/marketing/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/meta/marketing/index.ts --format esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "validate": "pnpm check-types && pnpm test",
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@unisane/growth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}
