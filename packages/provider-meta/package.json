{
  "name": "@unisane/provider-meta",
  "version": "0.1.0",
  "description": "Meta provider-family connection and control-plane operations for Unisane Ops",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "pack.manifest.json",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./marketing": {
      "types": "./dist/meta/marketing/index.d.ts",
      "import": "./dist/meta/marketing/index.js",
      "default": "./dist/meta/marketing/index.js"
    },
    "./cli": {
      "types": "./dist/cli/register.d.ts",
      "import": "./dist/cli/register.js",
      "default": "./dist/cli/register.js"
    },
    "./handlers/provider-meta": {
      "types": "./dist/cli/handler.d.ts",
      "import": "./dist/cli/handler.js",
      "default": "./dist/cli/handler.js"
    },
    "./pack-manifest": "./pack.manifest.json",
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/meta/marketing/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/meta/marketing/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@unisane/cli-core": "workspace:*",
    "@unisane/growth": "workspace:*",
    "@unisane/ops-engine": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}
