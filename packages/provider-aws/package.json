{
  "name": "@unisane/provider-aws",
  "version": "0.1.0-next.20260912.1",
  "description": "AWS provider-family operations for Unisane Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisanetech/unisane-ops.git",
    "directory": "packages/provider-aws"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "pack.manifest.json",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/register.d.ts",
      "import": "./dist/cli/register.js",
      "default": "./dist/cli/register.js"
    },
    "./handlers/provider-aws": {
      "types": "./dist/cli/handler.d.ts",
      "import": "./dist/cli/handler.js",
      "default": "./dist/cli/handler.js"
    },
    "./pack-manifest": "./pack.manifest.json",
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --watch",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "3.971.0",
    "@aws-sdk/client-cloudfront": "3.971.0",
    "@aws-sdk/client-route-53": "3.971.0",
    "@aws-sdk/client-s3": "3.971.0",
    "@aws-sdk/client-sesv2": "3.971.0",
    "@aws-sdk/client-sns": "3.971.0",
    "@aws-sdk/client-sts": "3.971.0",
    "@aws-sdk/credential-provider-ini": "3.971.0",
    "@unisane/cloud": "workspace:*",
    "@unisane/ops-engine": "workspace:*",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  },
  "private": false
}
