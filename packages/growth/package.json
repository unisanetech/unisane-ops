{
  "name": "@unisane/growth",
  "version": "0.1.0",
  "description": "Provider-neutral growth operations contracts and workflows for Unisane",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "pack.manifest.json",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./playbooks": {
      "types": "./dist/playbooks/index.d.ts",
      "import": "./dist/playbooks/index.js",
      "default": "./dist/playbooks/index.js"
    },
    "./console": {
      "types": "./dist/console/index.d.ts",
      "import": "./dist/console/index.js",
      "default": "./dist/console/index.js"
    },
    "./gtm": {
      "types": "./dist/gtm/index.d.ts",
      "import": "./dist/gtm/index.js",
      "default": "./dist/gtm/index.js"
    },
    "./marketing": {
      "types": "./dist/marketing/index.d.ts",
      "import": "./dist/marketing/index.js",
      "default": "./dist/marketing/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js",
      "default": "./dist/seo/index.js"
    },
    "./cli": {
      "types": "./dist/cli/register.d.ts",
      "import": "./dist/cli/register.js",
      "default": "./dist/cli/register.js"
    },
    "./handlers/growth": {
      "types": "./dist/cli/handler.d.ts",
      "import": "./dist/cli/handler.js",
      "default": "./dist/cli/handler.js"
    },
    "./pack-manifest": "./pack.manifest.json",
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/actions/index.ts src/playbooks/index.ts src/contracts.ts src/config.ts src/readiness.ts src/console/index.ts src/gtm/index.ts src/marketing/index.ts src/seo/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --clean --external @unisane/growth --external @unisane/growth/*",
    "dev": "tsup src/index.ts src/actions/index.ts src/playbooks/index.ts src/contracts.ts src/config.ts src/readiness.ts src/console/index.ts src/gtm/index.ts src/marketing/index.ts src/seo/index.ts src/cli/register.ts src/cli/handler.ts --format esm --dts --watch --external @unisane/growth --external @unisane/growth/*",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@unisane/ops-engine": "workspace:*",
    "commander": "^12.0.0",
    "playwright-core": "1.57.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  }
}
