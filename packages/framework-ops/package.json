{
  "name": "@unisane/framework-ops",
  "version": "0.1.0-next.20260913.1",
  "description": "Descriptor-only Unisane Framework integration for Unisane Ops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unisanetech/unisane-ops.git",
    "directory": "packages/framework-ops"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "unisane.meta.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./meta": "./unisane.meta.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint src scripts tests --max-warnings 0",
    "test": "pnpm build && vitest run src && node --test tests/*.test.mjs",
    "check-types": "tsc --noEmit",
    "check:boundary": "node scripts/verify-release-boundary.mjs --source-only",
    "pack:check": "pnpm build && node scripts/verify-release-boundary.mjs",
    "prepublishOnly": "pnpm pack:check && pnpm check-types && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "unisane": {
    "kind": "tooling",
    "edition": "oss",
    "meta": "./unisane.meta.json"
  },
  "private": false
}
